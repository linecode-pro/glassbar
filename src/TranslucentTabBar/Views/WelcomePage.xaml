<Page
    x:Class="TranslucentTabBar.Views.WelcomePage"
    x:Uid="WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                Padding="24">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleBlock" x:Uid="Welcome_Title" Text="Glassbar"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <TextBlock x:Name="SubtitleBlock" x:Uid="Welcome_Subtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Padding="24" Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Name="DescriptionBlock" x:Uid="Welcome_Description"
                       TextWrapping="WrapWholeWords"
                       Style="{StaticResource BodyTextBlockStyle}" />

            <HyperlinkButton x:Name="GitHubButton" x:Uid="Welcome_GitHub"
                             NavigateUri="https://github.com/linecode-pro/glassbar"
                             Content="GitHub" />
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="VersionBlock"
                       x:Uid="Welcome_Version"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       Style="{StaticResource CaptionTextBlockStyle}" />

            <Button x:Name="OkButton" Grid.Column="1"
                    x:Uid="Welcome_OK"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnOkClicked"
                    MinWidth="100" />

            <TextBlock Grid.Column="2"
                       x:Name="CopyrightBlock"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       Style="{StaticResource CaptionTextBlockStyle}">
                <Hyperlink NavigateUri="https://linecode.pro">
                    <Run Text="© 2026 linecode.pro" />
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Page>
