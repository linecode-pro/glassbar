<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TranslucentTabBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TranslucentTabBar">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="{ThemeResource SystemBaseLowColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeWhiteBrush" Color="White" />
            <SolidColorBrush x:Key="SystemControlAccentAcrylicWindowAccentMediumBrush" Color="{ThemeResource SystemAccentColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
